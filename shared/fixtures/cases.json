      ],
      "expect": [
        "armed",
        "none",
        "double",
        "none",
        "none"
      ]
    },
    {
      "name": "custom window",
      "windowMs": 200,
      "events": [
        {
          "type": "press",
          "t": 0
        },
        {
          "type": "release"
        },
        {
          "type": "press",
          "t": 250
        }
      ],
      "expect": [
