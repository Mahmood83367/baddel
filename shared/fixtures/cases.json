      "text": "ugd;l",
      "target": {
        "type": "lastWord",
        "caret": 5
      },
      "hint": null,
      "expect": {
        "location": 0,
        "length": 5,
        "replacement": "عليكم",
        "sourceScript": "latin"
      }
    },
    {
      "name": "last word skips trailing whitespace",
      "arabicLayout": "arabic-pc",
      "text": "hgsghl ugd;l  ",
