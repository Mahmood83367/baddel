{
  "conversions": [
    {
      "name": "British Mac shift-3 maps by physical key",
      "from": "uk-english-mac",
      "to": "arabic-pc",
      "input": "£",
      "output": "#"
    },
    {
      "name": "greeting punctuation key is a letter (PC)",
      "from": "us-english",
      "to": "arabic-pc",
      "input": "ugd;l",
      "output": "عليكم"
    },
    {
      "name": "greeting punctuation key is a letter (Mac)",
      "from": "us-english",
      "to": "arabic-mac",
      "input": "ugd;l",
      "output": "عليكم"
    },
    {
      "name": "phrase keeps spaces",
      "from": "us-english",
      "to": "arabic-pc",
      "input": "hgsghl ugd;l",
      "output": "السلام عليكم"
    },
    {
      "name": "PC lam-alef key",
      "from": "us-english",
      "to": "arabic-pc",
      "input": "b",
      "output": "لا"
    },
    {
      "name": "PC lam-alef maps back to one key",
      "from": "arabic-pc",
      "to": "us-english",
      "input": "لا",
      "output": "b"
    },
    {
      "name": "Mac has no lam-alef key",
      "from": "arabic-mac",
      "to": "us-english",
      "input": "لا",
      "output": "gh"
    },
    {
      "name": "PC shifted lam-alef-hamza",
      "from": "us-english",
      "to": "arabic-pc",
      "input": "T",
      "output": "لإ"
    },
    {
      "name": "PC shifted lam-alef-hamza back",
      "from": "arabic-pc",
      "to": "us-english",
      "input": "لإ",
      "output": "T"
    },
    {
      "name": "marhaba on PC",
      "from": "us-english",
      "to": "arabic-pc",
      "input": "lvpfh",
      "output": "مرحبا"
    },
    {
      "name": "marhaba on Mac",
      "from": "us-english",
      "to": "arabic-mac",
      "input": "lnpfh",
      "output": "مرحبا"
    },
    {
      "name": "hello typed in Arabic-PC",
      "from": "arabic-pc",
      "to": "us-english",
      "input": "اثممخ",
      "output": "hello"
    },
    {
      "name": "capital via shift on PC",
      "from": "arabic-pc",
      "to": "us-english",
      "input": "أثممخ",
      "output": "Hello"
    },
    {
      "name": "capital via shift on Mac",
      "from": "arabic-mac",
      "to": "us-english",
      "input": "آثممخ",
      "output": "Hello"
    },
    {
      "name": "capital to PC",
      "from": "us-english",
      "to": "arabic-pc",
      "input": "Hello",
      "output": "أثممخ"
    },
    {
      "name": "question mark",
      "from": "us-english",
      "to": "arabic-pc",
      "input": "?",
      "output": "؟"
    },
    {
      "name": "comma is waw on PC",
      "from": "us-english",
      "to": "arabic-pc",
      "input": ",",
      "output": "و"
    },
    {
      "name": "comma is Arabic comma on Mac",
      "from": "us-english",
      "to": "arabic-mac",
      "input": ",",
      "output": "،"
    },
    {
      "name": "m is waw on Mac",
      "from": "us-english",
      "to": "arabic-mac",
      "input": "m",
      "output": "و"
    },
    {
      "name": "empty shift level falls back to base (Mac)",
      "from": "us-english",
      "to": "arabic-mac",
      "input": "Fhf",
      "output": "باب"
    },
    {
      "name": "digits become Arabic-Indic",
      "from": "us-english",
      "to": "arabic-pc",
      "input": "2024",
      "output": "٢٠٢٤"
    },
    {
      "name": "Arabic-Indic digits back",
      "from": "arabic-mac",
      "to": "us-english",
      "input": "٢٠٢٤",
      "output": "2024"
    },
    {
      "name": "emoji and unknown characters pass through",
      "from": "us-english",
      "to": "arabic-pc",
      "input": "ugd;l 😀 é",
      "output": "عليكم 😀 é"
    },
    {
      "name": "whitespace is preserved",
      "from": "us-english",
      "to": "arabic-pc",
      "input": " ugd;l\t\n",
      "output": " عليكم\t\n"
    },
    {
      "name": "Arabic question back",
      "from": "arabic-pc",
      "to": "us-english",
      "input": "؟",
      "output": "?"
    }
  ],
  "plans": [
    {
      "name": "last word, caret at end",
