  "doublePress": [
    {
      "name": "single press",
      "windowMs": 300,
      "events": [
        {
          "type": "press",
          "t": 0
        },
        {
          "type": "release"
        },
        {
          "type": "timeout"
        }
      ],
      "expect": [
        "armed",
        "none",
        "single"
      ]
    },
    {
      "name": "double press",
      "windowMs": 300,
      "events": [
        {
          "type": "press",
          "t": 0
        },
        {
          "type": "release"
        },
        {
          "type": "press",
          "t": 150
        },
        {
          "type": "release"
        },
        {
          "type": "staleTimeout"
        }
      ],
      "expect": [
        "armed",
        "none",
        "double",
        "none",
        "none"
      ]
    },
    {
      "name": "double press at the window edge",
      "windowMs": 300,
      "events": [
        {
          "type": "press",
          "t": 0
        },
        {
          "type": "release"
        },
        {
          "type": "press",
          "t": 300
        }
      ],
      "expect": [
        "armed",
        "none",
        "double"
      ]
    },
    {
      "name": "held key repeats are ignored",
      "windowMs": 300,
      "events": [
        {
          "type": "press",
          "t": 0
        },
        {
          "type": "repeat",
          "t": 100
        },
        {
          "type": "repeat",
          "t": 200
        },
        {
          "type": "timeout"
        },
        {
          "type": "repeat",
          "t": 400
        },
        {
          "type": "release"
        }
      ],
      "expect": [
        "armed",
        "none",
        "none",
        "single",
        "none",
        "none"
      ]
    },
    {
      "name": "second press without release is ignored",
      "windowMs": 300,
      "events": [
        {
          "type": "press",
          "t": 0
        },
        {
          "type": "press",
          "t": 100
        },
        {
          "type": "timeout"
        }
      ],
      "expect": [
        "armed",
        "none",
        "single"
      ]
    },
    {
      "name": "late second press runs the pending single",
      "windowMs": 300,
      "events": [
        {
          "type": "press",
          "t": 0
        },
        {
          "type": "release"
        },
        {
          "type": "press",
          "t": 400
        },
        {
          "type": "release"
        },
        {
          "type": "timeout"
        }
      ],
      "expect": [
        "armed",
        "none",
        "singleThenArmed",
        "none",
        "single"
      ]
    },
    {
      "name": "third press starts a new cycle",
      "windowMs": 300,
      "events": [
        {
          "type": "press",
          "t": 0
        },
        {
          "type": "release"
        },
        {
          "type": "press",
          "t": 100
        },
        {
          "type": "release"
        },
        {
          "type": "press",
          "t": 200
        },
        {
          "type": "release"
        },
        {
          "type": "timeout"
        }
      ],
      "expect": [
        "armed",
        "none",
        "double",
        "none",
        "armed",
        "none",
        "single"
      ]
    },
    {
      "name": "stale timer after a double does nothing",
      "windowMs": 300,
      "events": [
        {
          "type": "press",
          "t": 0
        },
        {
          "type": "release"
