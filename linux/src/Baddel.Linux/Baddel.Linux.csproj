<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>baddel</AssemblyName>
    <RootNamespace>Baddel.Linux</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\..\VERSION').Trim())</Version>
    <Copyright>Copyright (c) 2026 Mahmood</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <!-- The platform-independent core is shared with the Windows app. -->
    <ProjectReference Include="..\..\..\windows\src\Baddel.Core\Baddel.Core.csproj" />
  </ItemGroup>
</Project>
